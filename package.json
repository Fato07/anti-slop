{
  "name": "@sha256_nulled/oxlint-plugin-anti-slop",
  "version": "0.1.0",
  "description": "Opinionated Oxlint rules that reject low-evidence TypeScript and JavaScript patterns.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Fato07/anti-slop.git"
  },
  "homepage": "https://github.com/Fato07/anti-slop#readme",
  "bugs": "https://github.com/Fato07/anti-slop/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm test && pnpm typecheck && pnpm test:package",
    "lint": "oxlint src",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:package": "pnpm build && node scripts/test-package.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "@oxlint/plugins": "1.78.0"
  },
  "peerDependencies": {
    "oxlint": "1.78.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "oxlint": "1.78.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.33.0",
  "license": "MIT"
}
